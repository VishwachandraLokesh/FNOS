# Copy to backend/.env for local development. Never commit .env or real credentials.

# local | test | dev | uat | prod
FNOS_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
FNOS_LOG_LEVEL=INFO

# Comma-separated exact origins allowed to call the API from a browser (no wildcards).
FNOS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# DEVELOPMENT ONLY: mock sign-in with an in-memory session cookie (POST/GET/DELETE /api/v1/session).
# The API refuses to start if this is true while FNOS_ENVIRONMENT is not local or test.
FNOS_MOCK_AUTH_ENABLED=true
# Mock session lifetime in minutes (1–1440).
FNOS_MOCK_SESSION_TTL_MINUTES=480
# DEVELOPMENT ONLY: fictional Dashboard data (/api/v1/dashboard/*). Requires mock auth above.
FNOS_MOCK_DATA_ENABLED=true
