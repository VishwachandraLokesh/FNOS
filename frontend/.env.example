# Copy to frontend/.env.local for local development.
# Every VITE_* value is compiled into the browser bundle and is public: never put secrets here.

# Base URL of the FNOS API, including the version prefix. Required.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds (1000–120000). Optional; defaults to 15000.
VITE_API_TIMEOUT_MS=15000
